{
  "*.{ts,tsx}": [
    "oxlint --fix --max-warnings=0 --disable-nested-config --no-error-on-unmatched-pattern",
    "oxfmt --disable-nested-config --no-error-on-unmatched-pattern"
  ],
  "*.{js,mjs,cjs,json,jsonc,yaml,yml,css,html}": "oxfmt --disable-nested-config --no-error-on-unmatched-pattern"
}
