  "type": "module",
  "scripts": {
    "build": "rm -rf ./dist && pnpm tsc --project tsconfig.build.json && pnpm tsc-alias --project tsconfig.build.json",
    "start": "pnpm build && pnpm start:prod",
    "start:prod": "node dist/main",
    "dev": "tsx watch --inspect=0 --clear-screen=false ./src/main.ts",
    "test:e2e": "vitest --config ./vitest.config.ts",
    "codegen": "tsx ./src/codegen.ts",
    "tscheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@tanstack/react-query": "^5.102.8",
    "@types/react": "^19.2.18",
    "nestjs-endpoints": "workspace:*",
    "react": "^19.2.8",
    "rxjs": "^7.8.2",
    "vitest": "^5.0.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.1",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.2.1",
    "axios": "^1.20.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.9.4",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "unplugin-swc": "^1.5.11",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
