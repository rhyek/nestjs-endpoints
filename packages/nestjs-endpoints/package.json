{
  "name": "nestjs-endpoints",
  "version": "0.0.0",
  "description": "A lightweight tool for writing clean and succinct HTTP APIs with NestJS that embraces the REPR design pattern, code colocation, and the Single Responsibility Principle.",
  "author": "Carlos González <carlos.rgn@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rhyek/nestjs-endpoints.git"
  },
  "keywords": [
    "nestjs",
    "endpoints",
    "repr",
    "openapi",
    "swagger",
    "file-based",
    "routing",
    "routes",
    "rest",
    "schema",
    "zod",
    "codegen",
    "trpc"
  ],
  "files": [
    "src",
    "dist",
    "docs",
    "assets"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "bin": {
    "nestjs-endpoints": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=24.22"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "test": "vitest",
    "tscheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kubb/ast": "5.20.1",
    "@kubb/core": "5.20.1",
    "@kubb/kit": "5.20.1",
    "@kubb/parser-ts": "5.20.1",
    "@kubb/plugin-axios": "6.0.3",
    "@kubb/plugin-react-query": "5.10.3",
    "@kubb/plugin-ts": "5.5.3",
    "callsites": "^4.2.0",
    "openapi-types": "^12.1.3",
    "zod-openapi": "^6.0.2"
  },
  "peerDependencies": {
    "@nestjs/common": ">=12.0.0",
    "@nestjs/core": ">=12.0.0",
    "@nestjs/swagger": ">=12.0.0",
    "zod": ">=4.1.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/swagger": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/swagger": "^12.1.1",
    "@types/node": "^26.6.6",
    "tsdown": "0.23.7",
    "typescript": "~7.0.2",
    "vitest": "^5.0.0"
  }
}
