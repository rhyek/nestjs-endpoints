{
  "name": "nestjs-endpoints",
  "version": "0.0.0",
  "description": "Write each NestJS endpoint as one file: its folder gives it a URL, its routers give it path parameters, providers and guards, and its Zod schemas give it validation and a typed axios or React Query client.",
  "author": "Carlos González <carlos.rgn@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rhyek/nestjs-endpoints.git"
  },
  "keywords": [
    "nestjs",
    "endpoints",
    "repr",
    "openapi",
    "swagger",
    "file-based",
    "routing",
    "routes",
    "rest",
    "schema",
    "zod",
    "codegen",
    "trpc"
  ],
  "files": [
    "src",
    "!src/**/*.spec.ts",
    "dist",
    "docs",
    "assets",
    "skills",
    "postinstall.js"
  ],
  "type": "module",
  "bin": {
    "nestjs-endpoints": "./dist/cli.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./docs/*": "./docs/*"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=24.22"
  },
  "scripts": {
    "postinstall": "node ./postinstall.js",
    "dev": "tsdown --watch",
    "test": "vitest",
    "tscheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kubb/ast": "5.20.1",
    "@kubb/core": "5.20.1",
    "@kubb/kit": "5.20.1",
    "@kubb/parser-ts": "5.20.1",
    "@kubb/plugin-axios": "6.0.3",
    "@kubb/plugin-client": "6.0.3",
    "@kubb/plugin-react-query": "5.10.3",
    "@kubb/plugin-ts": "5.5.3",
    "@kubb/plugin-zod": "5.9.3",
    "@kubb/renderer-jsx": "5.20.1",
    "callsites": "^4.2.0",
    "semver": "^7.8.5",
    "zod-openapi": "^6.0.2"
  },
  "peerDependencies": {
    "@nestjs/common": ">=12.0.0",
    "@nestjs/core": ">=12.0.0",
    "@nestjs/swagger": ">=12.0.0",
    "zod": ">=4.1.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/swagger": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/swagger": "^12.1.1",
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "tsdown": "0.23.7",
    "typescript": "7.1.0-beta",
    "vitest": "^5.0.0"
  }
}
