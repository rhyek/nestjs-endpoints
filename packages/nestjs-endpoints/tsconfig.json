{
  "compilerOptions": {
    // tsdown resolves the sources' extensionless relative imports and writes them out as
    // `./x.js`, so TypeScript resolves them as a bundler does.
    "module": "preserve",
    "moduleResolution": "bundler",
    // tsdown (oxc) compiles each file on its own.
    "isolatedModules": true,
    "lib": ["esnext"],
    "target": "esnext",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["src", "vitest.config.ts", "tsdown.config.ts"],
  "exclude": ["node_modules", "dist"]
}
