{
  "permissions": {
    "allow": ["Bash(npm test:*)"]
  },
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/skills/prepare-personal-git-workflow/scripts/worktree.ts\" hook create",
            "timeout": 900
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/skills/prepare-personal-git-workflow/scripts/worktree.ts\" hook remove",
            "timeout": 600
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/skills/prepare-personal-git-workflow/scripts/worktree.ts\" hook session-start",
            "timeout": 120
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/skills/prepare-personal-git-workflow/scripts/worktree.ts\" hook subagent-stop"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/skills/prepare-personal-git-workflow/scripts/worktree.ts\" hook guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "EnterWorktree|ExitWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/skills/prepare-personal-git-workflow/scripts/worktree.ts\" hook post-tool",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
