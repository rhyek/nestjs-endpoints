{
  "name": "nestjs-endpoints-monorepo",
  "author": "Carlos González <carlos.rgn@gmail.com>",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "./scripts/build.sh && ./scripts/test.sh",
    "dev": "pnpm --filter nestjs-endpoints --filter test-app-express run --parallel dev",
    "bench": "node benchmarks/scripts/run.ts",
    "bench:breakdown": "node benchmarks/scripts/breakdown.ts",
    "build": "./scripts/build.sh && pnpm --filter nestjs-endpoints-docs build && node scripts/package-docs.ts",
    "lint": "oxlint --disable-nested-config && oxfmt --check --disable-nested-config",
    "format": "oxfmt --disable-nested-config",
    "docs:dev": "./scripts/build.sh && dotenvx run -f .env.local --ignore=MISSING_ENV_FILE -- pnpm --filter nestjs-endpoints-docs dev",
    "docs:preview": "pnpm --filter nestjs-endpoints-docs preview",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.38.2",
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/swagger": "^12.1.1",
    "@types/node": "^26.6.6",
    "lint-staged": "^17.6.0",
    "simple-git-hooks": "^2.14.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "reflect-metadata": "^0.2.2",
    "typescript": "7.1.0-beta",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "@rhyek/oxc-config": "workspace:*"
  }
}
