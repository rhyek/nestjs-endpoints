    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "reflect-metadata": "^0.2.2",
    "typescript": "^6.0.3",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "@rhyek/oxc-config": "workspace:*"
